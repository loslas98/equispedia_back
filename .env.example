# --- CHATWOOT CONFIGURATION ---
CHATWOOT_VERSION=v3.11.0
CHATWOOT_PORT=3000
CHATWOOT_FRONTEND_URL=https://chatwoot.midominio.com
CHATWOOT_SECRET_KEY=cambiar_por_un_secret_key_largo

# --- EVOLUTION API CONFIGURATION ---
EVOLUTION_API_VERSION=v2.1.2
EVOLUTION_API_PORT=8080
EVOLUTION_API_URL=https://evo.midominio.com
EVOLUTION_GLOBAL_API_KEY=cambiar_por_un_api_key_global_seguro

# --- CLOUDFLARE TUNNEL (Opcional si usas Cloudflare) ---
CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui
