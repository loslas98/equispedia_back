# --- DATABASE CONFIGURATION (PostgreSQL) ---
DB_NAME=equispedia_db
DB_USER=postgres
DB_PASSWORD=secretpassword
TIMEZONE=America/Santiago

# --- N8N CONFIGURATION ---
N8N_VERSION=latest
N8N_PORT=5678
N8N_HOST=n8n.midominio.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.midominio.com
